using ContentCms.API.Models; using Microsoft.EntityFrameworkCore; using var db = new ContentCmsDbContext(new DbContextOptionsBuilder<ContentCmsDbContext>().UseMySql("Server=192.168.88.252;Database=contentCmsDb;Uid=user;Pwd=password;SslMode=none;AllowPublicKeyRetrieval=True;", ServerVersion.AutoDetect("Server=192.168.88.252;Database=contentCmsDb;Uid=user;Pwd=password;SslMode=none;AllowPublicKeyRetrieval=True;")).Options); var logs = db.PluginLogEntries.OrderByDescending(l => l.Id).Take(5).ToList(); foreach(var l in logs) Console.WriteLine($"{l.Level}: {l.Message}");

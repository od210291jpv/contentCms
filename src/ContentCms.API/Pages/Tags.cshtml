@page
@model ContentCms.API.Pages.TagsModel
@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Tags</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">
            <i class="bi bi-plus-circle"></i> Create Tag
        </button>
    </div>
</div>

@if (TempData["ActionMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ActionMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ActionError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ActionError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tag</th>
                @if (Model.IsAdmin)
                {
                    <th>Owner</th>
                }
                <th>Content Count</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usage in Model.Tags)
            {
                var tag = usage.Tag;
                var tagContentUrl = Url.Page("/ContentManagement", new RouteValueDictionary { [$"{TagFilterQuery.TagIdsKey}[0]"] = tag.Id });
                <tr>
                    <td>@tag.Id</td>
                    <td><partial name="_TagBadge" model="new TagBadgeViewModel { Tag = tag }" /></td>
                    @if (Model.IsAdmin)
                    {
                        <td>@tag.OwnerId (@tag.Owner?.Username)</td>
                    }
                    <td>
                        <a href="@tagContentUrl" class="badge bg-secondary text-decoration-none" title="Show tagged content">
                            @usage.ContentCount
                        </a>
                    </td>
                    <td>@tag.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Actions
                            </button>
                            <ul class="dropdown-menu shadow">
                                <li>
                                    <a class="dropdown-item" href="@tagContentUrl">
                                        <i class="bi bi-list-ul"></i> View Content
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editTagModal"
                                       data-id="@tag.Id" data-name="@tag.Name" data-color="@tag.Color">
                                        <i class="bi bi-pencil"></i> Edit Tag
                                    </a>
                                </li>
                                <li>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="id" value="@tag.Id" />
                                        <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Delete this tag? It will be removed from all content.');">
                                            <i class="bi bi-trash"></i> Delete Tag
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Tags.Any())
            {
                <tr>
                    <td colspan="@(Model.IsAdmin ? 6 : 5)" class="text-center py-4 text-muted">No tags created yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Create Tag Modal -->
<div class="modal fade" id="createTagModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create Tag</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="createTagName">Name</label>
                        <input type="text" id="createTagName" name="name" class="form-control" required maxlength="@TagModel.NameMaxLength" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="createTagColor">Color</label>
                        <input type="color" id="createTagColor" name="color" class="form-control form-control-color" value="@TagModel.DefaultColor" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Tag Modal -->
<div class="modal fade" id="editTagModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Tag</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editTagId" name="id" />
                    <div class="mb-3">
                        <label class="form-label" for="editTagName">Name</label>
                        <input type="text" id="editTagName" name="name" class="form-control" required maxlength="@TagModel.NameMaxLength" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editTagColor">Color</label>
                        <input type="color" id="editTagColor" name="color" class="form-control form-control-color" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editModal = document.getElementById('editTagModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    document.getElementById('editTagId').value = btn.getAttribute('data-id');
                    document.getElementById('editTagName').value = btn.getAttribute('data-name');
                    document.getElementById('editTagColor').value = btn.getAttribute('data-color') || '@TagModel.DefaultColor';
                });
            }
        });
    </script>
}

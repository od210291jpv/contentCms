using ContentCms.API.Models; using Microsoft.EntityFrameworkCore; using var db = new ContentCmsDbContext(new DbContextOptionsBuilder<ContentCmsDbContext>().UseMySql("Server=192.168.88.252;Database=contentCmsDb;Uid=user;Pwd=password;SslMode=none;AllowPublicKeyRetrieval=True;", ServerVersion.AutoDetect("Server=192.168.88.252;Database=contentCmsDb;Uid=user;Pwd=password;SslMode=none;AllowPublicKeyRetrieval=True;")).Options); var p = db.Plugins.FirstOrDefault(x => x.Key == "parse-by-link"); if (p != null) { p.Script = "cms.on(\"content.action\", function(event) { var link = encodeURIComponent(event.path); cms.log.info(\"Pushing \" + link + \" to parser...\"); cms.http.get(\"http://192.168.88.252:8080/Content/ParseByLink?contentLink=\" + link); });"; db.SaveChanges(); Console.WriteLine("Updated"); }
